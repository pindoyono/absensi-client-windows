SERVER_URL=https://absen.smkn2malinau.sch.id

# Didapat dari admin saat registrasi device (POST /device/register di server)
DEVICE_ID=gerbang-utama-01
DEVICE_API_KEY=ganti_dengan_api_key_dari_admin

# Token akun layanan read-only untuk endpoint /jadwal/efektif — generate
# SEKALI oleh admin dengan cara yang sama seperti generate token guru
# (lihat docs/SETUP.md langkah 2b). BUKAN token guru pribadi.
GURU_SERVICE_JWT=ganti_dengan_token_layanan

# HARUS SAMA PERSIS dengan FACE_ENCRYPTION_KEY di server (.env server) —
# didistribusikan manual oleh admin, jangan dikirim lewat chat/email biasa
FACE_ENCRYPTION_KEY=ganti_sesuai_key_server

# Database lokal
DB_PATH=data/absensi_lokal.db
DB_ENCRYPTION_KEY=ganti_dengan_key_acak_khusus_device_ini

SYNC_INTERVAL_SECONDS=45
TOLERANSI_TERLAMBAT_MENIT=5

# Password panel admin (tombol ⚙️ Panel Admin di kiosk). WAJIB diisi —
# kalau kosong, akses panel admin DITOLAK (fail-closed). Gunakan password kuat.
ADMIN_PASSWORD=

# Secret JWT server — HARUS SAMA dengan JWT_SECRET di server. Dipakai untuk
# verifikasi signature token admin lokal. Kalau kosong, login admin dianggap
# tidak valid (fail-closed).
JWT_SECRET=

# Jumlah thread untuk operasi BLAS/NumPy (opsional). Default: jumlah core CPU.
# ABSENSI_NUM_THREADS=4
